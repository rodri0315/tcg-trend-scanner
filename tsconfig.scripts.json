{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "isolatedModules": false,
    "incremental": false,
    "plugins": []
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "app", "components"]
}
