{
  "name": "pokemon-trend-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Internal TCG trend and arbitrage scanner",
  "scripts": {
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc -p tsconfig.scripts.json",
    "build:web": "next build",
    "test": "npm run build:cli && node --test dist/src/auth/basicAuth.test.js dist/src/economics/liquidity.test.js dist/src/economics/netOutcome.test.js dist/src/opportunities/quality.test.js dist/src/services/listingIdentity.test.js dist/src/services/marketPricing.test.js",
    "dev": "next dev",
    "start": "next start",
    "cli:dev": "ts-node -P tsconfig.scripts.json src/index.ts",
    "db:check": "ts-node -P tsconfig.scripts.json scripts/dbCheck.ts",
    "audit:listings": "ts-node -P tsconfig.scripts.json scripts/auditListingIdentity.ts",
    "seed": "ts-node -P tsconfig.scripts.json scripts/seed.ts",
    "daily": "ts-node -P tsconfig.scripts.json src/jobs/daily.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "next": "^16.1.6",
    "pg": "^8.13.1",
    "react": "^19.2.4",
    "react-aria-components": "^1.16.0",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
