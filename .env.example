DATABASE_URL=postgresql://postgres:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=true

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_AUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_VERIFICATION_TOKEN=replace-with-32-to-80-char-token

APP_BASE_URL=https://your-deployed-app.example.com
REPORTS_DIR=reports

# Exit assumptions. Direct collector and vendor scenarios are always calculated.
EXIT_COLLECTOR_DISCOUNT_PCT=5
EXIT_COLLECTOR_RISK_RESERVE_PCT=0
EXIT_COLLECTOR_FIXED_COST=0
EXIT_COLLECTOR_SHIPPING=0
EXIT_COLLECTOR_MATERIALS=0
EXIT_VENDOR_PAYOUT_PCT=80
EXIT_VENDOR_FIXED_COST=0
EXIT_ACQUISITION_COSTS=0
EXIT_TARGET_NET_ROI_PCT=20

# Optional eBay exit scenario.
EXIT_EBAY_FEE_PCT=
EXIT_EBAY_DISCOUNT_PCT=0
EXIT_EBAY_RISK_RESERVE_PCT=2
EXIT_EBAY_FIXED_FEE=0.40
EXIT_EBAY_SHIPPING=5
EXIT_EBAY_MATERIALS=1
